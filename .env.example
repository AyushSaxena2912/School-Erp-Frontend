# Same-origin is the supported model (FOUNDATION §4.4): leave VITE_API_URL empty
# so requests go to /api on this origin and the Vite proxy forwards them to
# Frappe. The HttpOnly session cookie then works with no CORS.
VITE_API_URL=

# Where the dev proxy forwards /api. Defaults to http://education.local:8002.
VITE_PROXY_TARGET=http://education.local:8002

# Dev-only. Set to "true" to render local seed data alongside backend results.
# Ignored in production builds — demo rows must never reach real users (F-18).
VITE_USE_DEMO_DATA=false
